{
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "desktop:dev": "vite build && electron electron/main.cjs",
    "desktop:build": "vite build && electron-builder --win portable"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest",
    "@capacitor/core": "6.2.1",
    "@capacitor/android": "6.2.1",
    "@capacitor/filesystem": "6.0.3",
    "@capacitor/share": "6.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.1",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ls.org.lba.admin",
    "productName": "LBA Tournament Desktop",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "artifactName": "LBA-Tournament-Desktop-${version}-${arch}.exe"
  },
  "name": "lba-tournament-desktop",
  "version": "1.0.0",
  "description": "Lesotho Badminton Association tournament and ranking administration system",
  "author": "Lesotho Badminton Association"
}
